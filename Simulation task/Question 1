# Edge AI Workflow for Intelligent Wireless Data Filtering
import numpy as np
from sklearn.ensemble import RandomForestClassifier
# -------------------------------
# Step 1: Generate wireless data
# -------------------------------
np.random.seed(42)
# Features: RSSI, SNR, Latency, Packet Loss
X_train = np.array([
[-50, 25, 10, 1],
[-55, 22, 15, 2],
[-60, 20, 20, 3],
[-70, 10, 60, 10],
[-75, 8, 80, 15],
[-45, 30, 5, 0]
])
# 0 = Unwanted/poor data, 1 = Useful data
y_train = np.array([1, 1, 1, 0, 0, 1])
# -------------------------------
# Step 2: Train Edge AI model
# -------------------------------
model = RandomForestClassifier(
n_estimators=50,
random_state=42
)
model.fit(X_train, y_train)
# -------------------------------
# Step 3: Receive wireless data
# -------------------------------
wireless_data = np.array([
[-52, 24, 12, 1],
[-72, 9, 70, 12],
[-48, 28, 8, 0],
[-68, 11, 55, 8]
])
# -------------------------------
# Step 4: Intelligent filtering
# -------------------------------
prediction = model.predict(wireless_data)
print("EDGE AI WIRELESS DATA FILTERING")
print("--------------------------------")
for i, result in enumerate(prediction):
if result == 1:
print(f"Data {i+1}: USEFUL → Forward to Cloud")
else:
print(f"Data {i+1}: UNWANTED → Filter at Edge")
