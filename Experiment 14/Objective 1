clc;
clear;
close all;
% SNR values (dB)
SNR = 0:5:30;
% Maximum Throughput (Mbps)
Max_TP = 100;
% Throughput calculation
Throughput = Max_TP * (1 - exp(-SNR/10));
% Display results
disp('SNR(dB)   Throughput(Mbps)');
disp([SNR' Throughput']);
figure;
% -------- Graph 1: 5G Throughput vs SNR --------
subplot(2,1,1);
plot(SNR, Throughput, '-o', 'LineWidth', 2);
grid on;
title('5G Throughput vs SNR');
xlabel('Signal-to-Noise Ratio (dB)');
ylabel('Throughput (Mbps)');
% -------- Graph 2: Throughput at Different SNR Levels --------
subplot(2,1,2);
bar(Throughput);
grid on;
title('Throughput at Different SNR Levels');
xlabel('SNR Index');
ylabel('Throughput (Mbps)');
