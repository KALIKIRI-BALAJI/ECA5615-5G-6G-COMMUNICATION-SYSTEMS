clc;
clear;
close all;
SNR_dB = 0:2:20;
BER = zeros(size(SNR_dB));
Nt = 2;
Nr = 2;
N = 10000;   % Number of bits
for k = 1:length(SNR_dB)
snr = 10^(SNR_dB(k)/10);
noiseVar = 1/snr;
errors = 0;
for n = 1:N/2
% Generate two bits
bits = randi([0 1],Nt,1);
% BPSK modulation
x = 2*bits-1;
% Rayleigh channel
H = (randn(Nr,Nt)+1j*randn(Nr,Nt))/sqrt(2);
% Noise
noise = sqrt(noiseVar/2)*(randn(Nr,1)+1j*randn(Nr,1));
% Received signal
y = H*x + noise;
% Zero Forcing detection
x_hat = pinv(H)*y;
% Hard decision
bits_hat = real(x_hat)>0;
errors = errors + sum(bits~=bits_hat);
end
BER(k)=errors/N;
end
figure;
subplot(2,1,1)
semilogy(SNR_dB,BER,'-o','LineWidth',2);
grid on;
xlabel('SNR (dB)');
ylabel('BER');
title('2×2 MIMO using Zero Forcing');
subplot(2,1,2)
plot(SNR_dB,1-BER,'-s','LineWidth',2);
grid on;
xlabel('SNR (dB)');
ylabel('Reliability');
title('Reliability vs SNR');
