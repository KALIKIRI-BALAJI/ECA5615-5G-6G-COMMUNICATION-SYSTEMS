clc;
clear;
close all;
users = 10:10:100;
snr_dB = 20;
snr_linear = 10^(snr_dB/10);
interference = 0.05*users;
sinr_linear = snr_linear./(1 + interference);
sinr_dB = 10*log10(sinr_linear);
spectrum_efficiency = log2(1 + sinr_linear);
bandwidth = 20;
throughput = bandwidth*spectrum_efficiency;
figure;
subplot(2,1,1);
plot(users,sinr_dB,'-o','LineWidth',2,'MarkerSize',6);
grid on;
xlabel('Number of Users');
ylabel('SINR (dB)');
title('SINR Variation with User Density');
subplot(2,1,2);
plot(users,interference,'-s','LineWidth',2,'MarkerSize',6);
grid on;
xlabel('Number of Users');
ylabel('Interference Level');
title('Interference Variation with User Density');
figure;
subplot(2,1,1);
plot(users,spectrum_efficiency,'-o','LineWidth',2,'MarkerSize',6);
grid on;
xlabel('Number of Users');
ylabel('Spectrum Efficiency (bps/Hz)');
title('Spectrum Efficiency in Dense Communication Zones');
subplot(2,1,2);
plot(users,throughput,'-s','LineWidth',2,'MarkerSize',6);
grid on;
xlabel('Number of Users');
ylabel('Throughput (Mbps)');
title('Network Throughput in Dense Communication Zones');
