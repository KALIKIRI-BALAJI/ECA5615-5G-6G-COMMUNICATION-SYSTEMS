clc;
clear;
close all;
% Parameters
fs = 1000;          % Sampling frequency (Hz)
t = 0:1/fs:1;       % Time vector (1 second)
TBW = 600;          % Total Bandwidth (kHz)
Users = 3;          % Number of Users
CBW = TBW / Users;  % Bandwidth per User (kHz)
% Carrier frequencies for each user
fc = [100 300 500];
% Message signal
m = sin(2*pi*10*t);
% Modulated signals for each user
s1 = m .* cos(2*pi*fc(1)*t);
s2 = m .* cos(2*pi*fc(2)*t);
s3 = m .* cos(2*pi*fc(3)*t);
% Plot FDMA signals
figure;
subplot(2,1,1);
plot(t, s1, 'r', 'LineWidth', 1.5);
hold on;
plot(t, s2, 'g', 'LineWidth', 1.5);
plot(t, s3, 'b', 'LineWidth', 1.5);
grid on;
title('FDMA Channel Allocation');
xlabel('Time (s)');
ylabel('Amplitude');
legend('User 1 (100 Hz)', 'User 2 (300 Hz)', 'User 3 (500 Hz)');
% Plot bandwidth allocation
subplot(2,1,2);
bar(1:Users, CBW * ones(1, Users));
grid on;
title('Channel Bandwidth per User');
xlabel('Users');
ylabel('Channel Bandwidth (kHz)');
xticks(1:Users);
xticklabels({'User 1','User 2','User 3'});
% Display bandwidth information
disp('FDMA Channel Allocation');
disp(['Total Bandwidth = ', num2str(TBW), ' kHz']);
disp(['Number of Users = ', num2str(Users)]);
disp(['Bandwidth per User = ', num2str(CBW), ' kHz']);
