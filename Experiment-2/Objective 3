clc;
clear;
close all;
% Parameters
Users = 1:8;          % Total users
TotalSlots = 5;       % Available slots
% Initialize allocation
Alloc = zeros(1,8);
Alloc(1:TotalSlots) = 1;    % Allocate slots to first 5 users
% Blocked users
Blocked = 1 - Alloc;
% Display allocation table
disp('User Wise Slot Allocation');
disp(table(Users', Alloc', ...
    'VariableNames', {'User','Status_1_Allocated_0_Blocked'}));
% Plot graphs
figure;
% Graph 1: Slot allocation
subplot(2,1,1);
stem(Users, Alloc, 'filled', 'LineWidth', 2);
title('TDMA Slot Allocation per User');
xlabel('User Index');
ylabel('Slot Status (1 = Allocated, 0 = Blocked)');
ylim([-0.2 1.2]);
grid on;
% Graph 2: Allocation vs Blocked
subplot(2,1,2);
plot(Users, Alloc, '-o', 'LineWidth', 2);
hold on;
plot(Users, Blocked, '-s', 'LineWidth', 2);
title('TDMA Slot Utilization Analysis');
xlabel('User Index');
ylabel('Status');
legend('Allocated','Blocked','Location','best');
grid on;
