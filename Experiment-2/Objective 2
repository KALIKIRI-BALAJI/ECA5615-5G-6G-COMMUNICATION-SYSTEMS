clc;
clear;
close all;
% Parameters
TotalSlots = 8;
AllocatedSlots = 6;
FreeSlots = TotalSlots - AllocatedSlots;
% Frame Utilization
Utilization = (AllocatedSlots / TotalSlots) * 100;
% Display Result
disp('Frame Utilization (%)');
disp(Utilization);
% Plot Graphs
figure;
% Graph 1: Allocated vs Free Slots
subplot(2,1,1);
plot([1 2], [AllocatedSlots FreeSlots], '-o', 'LineWidth', 2);
title('GSM Frame Utilization (Allocated vs Free)');
xlabel('Slot Type Index (1 = Allocated, 2 = Free)');
ylabel('Number of Slots');
grid on;
% Graph 2: Pie Chart of Slot Distribution
subplot(2,1,2);
pie([AllocatedSlots FreeSlots], {'Allocated','Free'});
title('GSM Slot Distribution');
