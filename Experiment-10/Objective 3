clc;
clear;
close all;
% 5G Network Slice Types
slices = [1 2 3 4 5];
% End-to-End Latency (ms)
latency = [25 5 40 15 60];
% Create line plot
figure;
plot(slices, latency, '-o', ...
'LineWidth', 2, ...
'MarkerSize', 8);
grid on;
% Set x-axis labels
xticks(slices);
xticklabels({'eMBB','URLLC','mMTC','Private','IoT'});
% Axis labels
xlabel('Network Slice Type');
ylabel('End-to-End Latency (ms)');
% Title
title('5G Network Slicing: End-to-End Latency');
% Set y-axis range
ylim([0 70]);
